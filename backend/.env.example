# Copia questo file in backend/.env e compila i valori (il file .env non va mai su GitHub)
MONGO_URL=mongodb://localhost:27017
DB_NAME=trading
# Stringa casuale lunga: openssl rand -hex 32
SECRET_KEY=
PORT=8003

# Analisi "Ragiona ora" con Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: più alto = ragionamento più profondo e costo maggiore
AI_EFFORT=high

# OKX: per OKX Europa (my.okx.com) usare https://eea.okx.com
OKX_BASE_URL=https://eea.okx.com
# Chiave API OKX con il SOLO permesso "Leggi" e IP limitato alla VPS (facoltativa)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Notifiche Telegram (facoltative): token da @BotFather, chat id con telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Copia questo file in backend/.env e compila i valori (il file .env non va mai su GitHub)
MONGO_URL=mongodb://localhost:27017
DB_NAME=trading
# Stringa casuale lunga: openssl rand -hex 32
SECRET_KEY=
PORT=8003

# Analisi "Ragiona ora" con Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: più alto = ragionamento più profondo e costo maggiore
AI_EFFORT=high
